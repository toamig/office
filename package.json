{
  "name": "office",
  "version": "0.1.0",
  "description": "One desktop workspace for every project, agent session, repo and note.",
  "main": "./out/main/index.js",
  "license": "MIT",
  "author": "toamig",
  "homepage": "https://github.com/toamig/office",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "build:web": "vite build -c vite.host.config.ts && vite build -c vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "electron-vite build && playwright test",
    "e2e:web": "npm run build:web && playwright test -c playwright.web.config.ts",
    "dev:web": "node scripts/dev-web.mjs",
    "dist": "electron-vite build && electron-builder --win nsis",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "13.2.0",
    "chokidar": "6.0.0",
    "croner": "11.0.1",
    "dockview-react": "^8.9.1",
    "electron-updater": "6.8.11",
    "lucide-react": "1.75.0",
    "node-pty": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "ws": "8.23.0"
  }
}
